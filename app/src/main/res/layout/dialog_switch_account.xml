<?xml version="1.0" encoding="utf-8"?>
<!-- v76 切换账号认证弹窗：密码或扫码，二者都通过后才真正切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llSwitchRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_24">

    <TextView
        android:id="@+id/tvSwitchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="切换账号"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />

    <TextView
        android:id="@+id/tvSwitchTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:text="请输入该账号的密码；或使用手机扫码（需登录该账号）"
        android:textColor="@color/color_CCFFFFFF"
        android:textSize="@dimen/ts_20" />

    <EditText
        android:showSoftInputOnFocus="false"
        android:id="@+id/etSwitchPass"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_56"
        android:layout_marginTop="@dimen/vs_16"
        android:background="@drawable/input_account_field"
        android:gravity="center_vertical"
        android:hint="密码"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:includeFontPadding="false"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_CCFFFFFF"
        android:textSize="@dimen/ts_22" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSwitchOk"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_56"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:text="切换"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnSwitchQr"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_56"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginStart="@dimen/vs_12"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:text="二维码登录"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnSwitchCancel"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_56"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginStart="@dimen/vs_12"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSwitchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:text=""
        android:textColor="@color/dialog_control_stroke_focused"
        android:textSize="@dimen/ts_20" />
</LinearLayout>
