<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_440"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_20">

        <TextView
            android:id="@+id/tvSaveTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本次修改"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_300"
            android:layout_marginTop="@dimen/vs_14"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvSaveContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/vs_6"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSaveCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_28"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_28"
                android:paddingBottom="@dimen/vs_10"
                android:text="取消"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnSaveDiscard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_16"
                android:layout_marginLeft="@dimen/vs_16"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_28"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_28"
                android:paddingBottom="@dimen/vs_10"
                android:text="不保存"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnSaveOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_16"
                android:layout_marginLeft="@dimen/vs_16"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:paddingLeft="@dimen/vs_28"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_28"
                android:paddingBottom="@dimen/vs_10"
                android:text="保存"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
