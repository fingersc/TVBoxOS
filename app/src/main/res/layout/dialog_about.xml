<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <!--
        ★ 约束：本文件只允许出现一个文本属性（即下面 tvVersion 的空文本）。
        CI 构建时（.github/workflows/test.yml）会把构建号（如 20261017-1652）
        sed 前缀到本文件里每个文本属性的值上；AboutDialog.java 里会用
        BuildConfig.VERSION_NAME 覆盖 tvVersion（同一构建号、无换行尾缀）。
        其余文本（免责声明 / 调试模式状态）一律在 AboutDialog.java 里设置，
        否则会被误注入版本号。
    -->
    <LinearLayout
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />

        <!-- 调试模式开关：独立紧凑按钮，不与版本号同框；版本号仅作展示不可聚焦 -->
        <LinearLayout
            android:id="@+id/llAboutDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_15"
            android:layout_marginLeft="@dimen/vs_15"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingTop="@dimen/vs_5"
            android:paddingRight="@dimen/vs_15"
            android:paddingBottom="@dimen/vs_5">

            <TextView
                android:id="@+id/tvDebugOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDisclaimer"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:lineSpacingExtra="@dimen/ts_50"
        android:lineSpacingMultiplier="0"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />

</LinearLayout>
