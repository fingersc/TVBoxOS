<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="扫码登录"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />

    <ImageView
        android:id="@+id/ivQr"
        android:layout_width="@dimen/vs_400"
        android:layout_height="@dimen/vs_400"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/vs_20"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvQrTip"
        android:layout_width="@dimen/vs_520"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:text="请用手机上的本 App（需先登录）扫码，自动把账号同步到本机"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/btnScanOnPhone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/button_danmu_setting"
        android:focusable="true"
        android:gravity="center"
        android:text="我是手机，扫其它设备的码"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />
</LinearLayout>
